{
  "name": "link-shortener",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run check:scripts && turbo run check",
    "check:scripts": "tsc --project tsconfig.scripts.json",
    "dev": "turbo run dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:client": "bun run --cwd apps/client dev",
    "dev:proxy": "turbo run dev:proxy",
    "env:setup": "bun scripts/env/setup.ts",
    "format": "biome format --write .",
    "infra:down": "docker compose --env-file .env.dev down",
    "infra:dev:up": "docker compose --env-file .env.dev --profile dev-proxy up -d",
    "infra:up": "docker compose --env-file .env.dev --profile stack up --build -d",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@types/bun": "^1.4.4",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3"
  }
}
