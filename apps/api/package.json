{
  "name": "@lapinamk-ls/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/server.ts --outdir ./dist --target bun",
    "check": "tsc --noEmit",
    "cli": "bun src/cli.ts",
    "db:migrate": "bun src/migrate.ts",
    "dev": "bun --watch src/server.ts",
    "dev:proxy": "CLIENT_ORIGIN=http://localhost:8080 bun --watch src/server.ts",
    "lint": "biome check .",
    "start": "bun dist/server.js",
    "test": "bun test"
  },
  "dependencies": {
    "@lapinamk-ls/cli": "workspace:*",
    "@lapinamk-ls/database": "workspace:*",
    "@lapinamk-ls/domain": "workspace:*",
    "@fastify/cors": "^11.2.0",
    "fastify": "^5.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8"
  }
}
